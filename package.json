{
  "name": "my-pace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A private, local-first running companion.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "build:public": "node scripts/build.mjs --public",
    "prepare:running": "node scripts/prepare-running.mjs",
    "watch:running": "node scripts/watch-running.mjs",
    "authorize:running": "node scripts/authorize-running-drive.mjs",
    "prepare:gas-probe": "node scripts/build-running-gas-probe.mjs",
    "prepare:gas-incremental": "node scripts/build-running-gas-incremental.mjs",
    "prepare:gas-discovery": "node scripts/build-running-gas-discovery.mjs"
  },
  "dependencies": {
    "google-auth-library": "^11.3.4"
  }
}
