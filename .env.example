# Copy to .env.local (ignored by Git); use these as private Vercel environment variables.
MYPACE_ORIGIN=http://127.0.0.1:4173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random characters; never commit a real value.
MYPACE_SESSION_SECRET=
# Private MyPace management root; the server resolves running/derived below it.
# Replaces MYPACE_DRIVE_FOLDER_ID. Never put the old derived ID here.
MYPACE_ROOT_FOLDER_ID=
# Running artifacts always use running/derived/index.json. No catalog setting.
