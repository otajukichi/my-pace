# Never commit a real .env or paste secrets into chat.
# Public Google Identity client ID; no browser Drive token is used.
MYPACE_ORIGIN=https://my-pace-gules.vercel.app
GOOGLE_CLIENT_ID=
# Independently generate strong random server-only secrets outside chat.
MYPACE_SESSION_SECRET=
MYPACE_SECURITY_GENERATION=1
# Leave empty until verified owner login returns a subject to pin manually.
MYPACE_OWNER_SUB=
MYPACE_WRITER_URL=
MYPACE_WRITER_SECRET=
# Fixed production store ID from explicit editor bootstrap, not a probe folder.
MYPACE_STORE_ID=
