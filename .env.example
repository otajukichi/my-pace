# Copy to .env.local (ignored by Git); use these as private Vercel environment variables.
MYPACE_ORIGIN=http://127.0.0.1:4173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random characters; never commit a real value.
MYPACE_SESSION_SECRET=
# Existing private derived folder, not raw, system, or its parent.
MYPACE_DRIVE_FOLDER_ID=
MYPACE_DRIVE_CATALOG=new-csv-index.json
